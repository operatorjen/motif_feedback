# Linux users: set these to `id -u` and `id -g` if UID 10001 cannot write ./workspace.
APP_UID=10001
APP_GID=10001
APP_PORT=8000
USER_DISPLAY_NAME=User

# Add keys only for providers selected in the Setup screen. For a custom
# provider, add the variable named by its api_key_env catalog field here too.
MOONSHOT_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# EXAMPLE_PROVIDER_API_KEY=

MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1

PROVIDER_TIMEOUT_SECONDS=180
PROVIDER_CONNECT_TIMEOUT_SECONDS=20
PROVIDER_PARTICIPATION_RETRIES=2
PROVIDER_RESPONSE_MAX_BYTES=2000000
PROVIDER_TOOL_CALLS_PER_RESPONSE=16
PROVIDER_TOOL_CALLS_PER_TURN=48
MAX_CONTEXT_MESSAGES=30
MAX_TOOL_ROUNDS=6
MAX_AGENT_TURN_BEATS=3
LOCAL_MEMORY_CONTEXT_EVENTS=8
GLOBAL_MEMORY_CONTEXT_EVENTS=6
MAX_UPLOAD_BYTES=5242880
MAX_AGENT_WRITE_BYTES=15000

# Bounded, read-only fetching for URLs explicitly pasted into a prompt.
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_CONNECT_TIMEOUT_SECONDS=10
WEB_FETCH_CHUNK_BYTES=65536
# Optional local JSON list. Keep the real user-agent values only in your ignored .env.
# WEB_FETCH_USER_AGENTS=["paste your first user agent here","paste an optional second here"]
WEB_FETCH_USER_AGENT_ATTEMPTS=1
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_TEXT_CHARS=60000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_MAX_URLS=3
WEB_FETCH_CACHE_SECONDS=3600
WEB_FETCH_SEARCH_FALLBACK=true
WEB_PROMPT_MAX_TEXT_CHARS=60000

# Isolated runner transport, transcript, and input limits.
# RUNNER_TIMEOUT_SECONDS is the app-side response deadline; keep it slightly
# above RUNNER_EXECUTION_TIMEOUT_SECONDS.
RUNNER_TIMEOUT_SECONDS=65
RUNNER_EXECUTION_TIMEOUT_SECONDS=60
RUNNER_PROJECT_MAX_BYTES=8000000
RUNNER_OUTPUT_MAX_BYTES=64000
RUNNER_ROOM_TRANSCRIPT_MAX_CHARS=8000
RUNNER_INPUT_MAX_BYTES=16000
RUNNER_INPUT_MESSAGE_MAX_BYTES=4000
RUNNER_ARGUMENT_MAX_COUNT=24
RUNNER_ARGUMENT_MAX_CHARS=500
RUNNER_ARGUMENTS_MAX_BYTES=4000
RUNNER_REQUEST_MAX_BYTES=8500000
RUNNER_RESPONSE_MAX_BYTES=1000000
RUNNER_SOCKET_POLL_SECONDS=0.1
RUNNER_SOCKET_READ_BYTES=16384
RUNNER_SESSION_POLL_SECONDS=0.08
RUNNER_ROLE_SIGNAL_MAX_COUNT=16
RUNNER_CHILD_CPU_SECONDS=5
RUNNER_CHILD_FILE_MAX_BYTES=8000000
RUNNER_CHILD_OPEN_FILE_LIMIT=32
RUNNER_CHILD_MEMORY_MAX_BYTES=256000000
RUNNER_CHILD_PROCESS_LIMIT=16
RUNNER_STREAM_READ_BYTES=4096
RUNNER_CONTROL_READ_BYTES=4096
RUNNER_SELECT_POLL_SECONDS=0.05
RUNNER_ERROR_DETAIL_MAX_CHARS=2000

# Docker resource defaults. Leaving these unset preserves the same fallbacks.
APP_TMPFS_SIZE=128m
APP_PIDS_LIMIT=256
APP_MEMORY_LIMIT=2g
APP_CPUS=2.0
APP_STOP_GRACE_PERIOD=20s
APP_NOFILE_LIMIT=4096
APP_LOG_MAX_SIZE=10m
APP_LOG_MAX_FILES=3
RUNNER_TMPFS_SIZE=64m
RUNNER_PIDS_LIMIT=32
RUNNER_MEMORY_LIMIT=384m
RUNNER_CPUS=0.5
RUNNER_STOP_GRACE_PERIOD=5s
RUNNER_NOFILE_LIMIT=64
RUNNER_HEALTH_INTERVAL=10s
RUNNER_HEALTH_TIMEOUT=2s
RUNNER_HEALTH_RETRIES=3
RUNNER_HEALTH_START_PERIOD=5s
RUNNER_SOCKET_VOLUME_SIZE=1m
